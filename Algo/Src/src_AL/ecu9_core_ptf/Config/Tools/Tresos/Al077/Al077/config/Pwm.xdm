                  <a:a name="IMPORTER_INFO" value="@REC"/>
                </d:var>
                <d:lst name="PwmPowerStateAsynchTransitionMode"/>
                <d:var name="PwmTypeofInterruptFunction" type="ENUMERATION" 
                       value="PWM_ISR_CAT1"/>
                <d:lst name="PwmPowerStateConfig" type="MAP"/>
              </d:ctr>
              <d:ctr name="PwmPublishedInformation" type="IDENTIFIABLE">
                <a:a name="IMPORTER_INFO" value="@REC"/>
                <d:var name="PwmDeviceVariant" type="ENUMERATION" 
                       value="MSPM0G351x">
                  <a:a name="ENABLE" value="true"/>
                  <a:a name="IMPORTER_INFO" value="@REC"/>
                </d:var>
              </d:ctr>
            </d:ctr>
          </d:chc>
        </d:lst>
      </d:ctr>
    </d:lst>
  </d:ctr>

</datamodel>
