<?xml version='1.0'?>
<datamodel version="8.0" 
           xmlns="http://www.tresos.de/_projects/DataModel2/18/root.xsd" 
           xmlns:a="http://www.tresos.de/_projects/DataModel2/18/attribute.xsd" 
           xmlns:v="http://www.tresos.de/_projects/DataModel2/06/schema.xsd" 
           xmlns:d="http://www.tresos.de/_projects/DataModel2/06/data.xsd">

  <d:ctr type="AUTOSAR" factory="autosar" 
         xmlns:ad="http://www.tresos.de/_projects/DataModel2/08/admindata.xsd" 
         xmlns:ce="http://www.tresos.de/_projects/DataModel2/18/childenable.xsd" 
         xmlns:cd="http://www.tresos.de/_projects/DataModel2/08/customdata.xsd" 
         xmlns:f="http://www.tresos.de/_projects/DataModel2/14/formulaexpr.xsd" 
         xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd" 
         xmlns:mt="http://www.tresos.de/_projects/DataModel2/11/multitest.xsd"  
         xmlns:variant="http://www.tresos.de/_projects/DataModel2/11/variant.xsd">
    <d:lst type="TOP-LEVEL-PACKAGES">
      <d:ctr name="Gpt" type="AR-PACKAGE">
        <d:lst type="ELEMENTS">
          <d:chc name="Gpt" type="AR-ELEMENT" value="MODULE-CONFIGURATION">
            <d:ctr type="MODULE-CONFIGURATION">
              <a:a name="DEF" value="ASPath:/TI_MSPM0G351x/Gpt"/>
              <a:a name="IMPORTER_INFO" value="@REC"/>
              <d:var name="IMPLEMENTATION_CONFIG_VARIANT" type="ENUMERATION" 
                     value="VariantPostBuild">
                <a:a name="IMPORTER_INFO" value="@REC"/>
              </d:var>
              <d:lst name="GptChannelConfigSet" type="MAP">
                <d:ctr name="GptChannelConfigSet_0" type="IDENTIFIABLE">
                  <a:a name="IMPORTER_INFO" value="@REC"/>
                  <d:lst name="GptChannelConfiguration" type="MAP">
                    <d:ctr name="GptChannelConfiguration_0" type="IDENTIFIABLE">
                      <a:a name="IMPORTER_INFO" value="@REC"/>
                      <d:var name="GptChannelId" type="INTEGER" value="2"/>
                      <d:var name="GptTimerInstance" type="ENUMERATION" 
                             value="TIMG6">
                        <a:a name="IMPORTER_INFO">
                          <a:v>@CALC</a:v>
                          <a:v>@DEF</a:v>
                        </a:a>
                      </d:var>
                      <d:var name="GptType" type="ENUMERATION" value="DEDICATED"/>
                      <d:var name="GptChannelMode" type="ENUMERATION" 
                             value="GPT_CH_MODE_CONTINUOUS">
                        <a:a name="IMPORTER_INFO" value="@REC"/>
                      </d:var>
                      <d:var name="GptChannelTickFrequency" type="FLOAT" 
                             value="4096.0">
                        <a:a name="IMPORTER_INFO">
                          <a:v>@CALC</a:v>
                          <a:v>@DEF</a:v>
                        </a:a>
                      </d:var>
                      <d:var name="GptEnableWakeup" type="BOOLEAN" value="true">
                        <a:a name="IMPORTER_INFO" value="@REC"/>
                      </d:var>
                      <d:var name="GptPrescaler" type="INTEGER" value="1">
                        <a:a name="IMPORTER_INFO" value="@REC"/>
                      </d:var>
                      <d:var name="GptClockDivider" type="INTEGER" value="8"/>
                      <d:var name="GptShadowRegisterEnable" type="BOOLEAN" 
                             value="false">
                        <a:a name="IMPORTER_INFO" value="@REC"/>
                      </d:var>
                      <d:var name="GptRestoreTimerCounterEnable" type="BOOLEAN" 
                             value="false">
                        <a:a name="IMPORTER_INFO" value="@REC"/>
                      </d:var>
                      <d:var name="GptNotification" type="FUNCTION-NAME" 
                             value="Gpt_Channel_Notify1">
                        <a:a name="ENABLE" value="true"/>
                        <a:a name="IMPORTER_INFO" value="@REC"/>
                      </d:var>
                      <d:ref name="GptChannelClkSrcRef" type="REFERENCE" 
                             value="ASPath:/Gpt/Gpt/GptDriverConfiguration/GptClockReferencePoint_0">
                        <a:a name="IMPORTER_INFO" value="@REC"/>
                      </d:ref>
                      <d:ctr name="GptWakeupConfiguration" type="IDENTIFIABLE">
                        <a:a name="ENABLE" value="false"/>
                        <a:a name="IMPORTER_INFO" value="@REC"/>
                        <d:ref name="GptWakeupSourceRef" type="REFERENCE" >
                          <a:a name="IMPORTER_INFO" value="@REC"/>
                        </d:ref>
                      </d:ctr>
                      <d:var name="GptChannelTickValueMax" type="FLOAT" 
                             value="65535.0">
                        <a:a name="IMPORTER_INFO">
                          <a:v>@CALC</a:v>
                          <a:v>@DEF</a:v>
                        </a:a>
                      </d:var>
                    </d:ctr>
                  </d:lst>
                </d:ctr>
              </d:lst>
              <d:ctr name="GptConfigurationOfOptApiServices" 
                     type="IDENTIFIABLE">
                <a:a name="IMPORTER_INFO" value="@REC"/>
                <d:var name="GptDeinitApi" type="BOOLEAN" value="false"/>
                <d:var name="GptEnableDisableNotificationApi" type="BOOLEAN" 
                       value="true">
                  <a:a name="IMPORTER_INFO" value="@REC"/>
                </d:var>
                <d:var name="GptTimeElapsedApi" type="BOOLEAN" value="true">
                  <a:a name="IMPORTER_INFO" value="@REC"/>
                </d:var>
                <d:var name="GptTimeRemainingApi" type="BOOLEAN" value="true">
                  <a:a name="IMPORTER_INFO" value="@REC"/>
                </d:var>
                <d:var name="GptVersionInfoApi" type="BOOLEAN" value="true">
                  <a:a name="IMPORTER_INFO" value="@REC"/>
                </d:var>
                <d:var name="GptWakeupFunctionalityApi" type="BOOLEAN" 
                       value="false"/>
                <d:var name="GptRegisterReadback" type="BOOLEAN" value="true">
                  <a:a name="IMPORTER_INFO" value="@REC"/>
                </d:var>
              </d:ctr>
              <d:ctr name="GptDriverConfiguration" type="IDENTIFIABLE">
                <a:a name="IMPORTER_INFO" value="@REC"/>
                <d:var name="GptDevErrorDetect" type="BOOLEAN" value="false"/>
                <d:var name="GptPredefTimer100us32bitEnable" type="BOOLEAN" 
                       value="false">
                  <a:a name="IMPORTER_INFO" value="@REC"/>
                </d:var>
                <d:var name="GptPredefTimer1usEnablingGrade" type="ENUMERATION" 
                       value="GPT_PREDEF_TIMER_1US_DISABLED">
                  <a:a name="IMPORTER_INFO" value="@REC"/>
                </d:var>
                <d:var name="GptReportWakeupSource" type="BOOLEAN" value="false"/>
                <d:var name="GptTypeofInterruptFunction" type="ENUMERATION" 
                       value="GPT_ISR_CAT1">
                  <a:a name="IMPORTER_INFO" value="@REC"/>
                </d:var>
                <d:lst name="GptClockReferencePoint" type="MAP">
                  <d:ctr name="GptClockReferencePoint_0" type="IDENTIFIABLE">
                    <a:a name="IMPORTER_INFO" value="@REC"/>
                    <d:ref name="GptClockReference" type="REFERENCE" 
                           value="ASPath:/Mcu/Mcu/McuModuleConfiguration/McuClockSettingConfig_6/McuClockReferencePoint_0"/>
                  </d:ctr>
                </d:lst>
              </d:ctr>
              <d:ctr name="GptPublishedInformation" type="IDENTIFIABLE">
                <a:a name="IMPORTER_INFO" value="@REC"/>
                <d:var name="GptDeviceVariant" type="ENUMERATION" 
                       value="MSPM0G351x">
                  <a:a name="ENABLE" value="true"/>
                  <a:a name="IMPORTER_INFO" value="@REC"/>
                </d:var>
              </d:ctr>
              <d:ctr name="GptDemEventParameterRefs" type="IDENTIFIABLE">
                <a:a name="ENABLE" value="false"/>
                <a:a name="IMPORTER_INFO" value="@REC"/>
                <d:ref name="GPT_E_HARDWARE_ERROR" type="REFERENCE" >
                  <a:a name="ENABLE" value="false"/>
                  <a:a name="IMPORTER_INFO" value="@REC"/>
                </d:ref>
              </d:ctr>
            </d:ctr>
          </d:chc>
        </d:lst>
      </d:ctr>
    </d:lst>
  </d:ctr>

</datamodel>
