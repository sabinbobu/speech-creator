                    <a:v>@DEF</a:v>
                  </a:a>
                </d:var>
                <d:var name="SpiMaxExternalDeviceConfig" type="INTEGER" 
                       value="2">
                  <a:a name="IMPORTER_INFO">
                    <a:v>@CALC</a:v>
                    <a:v>@DEF</a:v>
                  </a:a>
                </d:var>
                <d:lst name="SpiChannel" type="MAP">
                  <d:ctr name="SpiChannel_0" type="IDENTIFIABLE">
                    <a:a name="IMPORTER_INFO" value="@REC"/>
                    <d:var name="SpiChannelId" type="INTEGER" value="0">
                      <a:a name="IMPORTER_INFO" value="@REC"/>
                    </d:var>
                    <d:var name="SpiChannelType" type="ENUMERATION" value="EB"/>
                    <d:var name="SpiDataWidth" type="INTEGER" value="8"/>
                    <d:lst name="SpiDefaultData">
                      <d:var type="INTEGER" value="0">
                        <a:a name="IMPORTER_INFO" value="@REC"/>
                      </d:var>
                    </d:lst>
                    <d:var name="SpiEbMaxLength" type="INTEGER" value="32">
                      <a:a name="IMPORTER_INFO" value="@REC"/>
                    </d:var>
                    <d:var name="SpiIbNBuffers" type="INTEGER" value="32">
                      <a:a name="IMPORTER_INFO" value="@REC"/>
                    </d:var>
                    <d:var name="SpiTransferStart" type="ENUMERATION" 
