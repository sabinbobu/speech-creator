                    </d:var>
                    <d:var name="SpiCsIdentifier" type="STRING" value="SCS1"/>
                    <d:var name="SpiCsPolarity" type="ENUMERATION" value="HIGH">
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:var>
                    <d:var name="SpiCsSelection" type="ENUMERATION" 
