                  </d:var>
                </d:lst>
                <d:var name="SpiVersionInfoApi" type="BOOLEAN" value="true">
                  <a:a name="IMPORTER_INFO" value="@REC"/>
                </d:var>
                <d:var name="SpiIrqType" type="ENUMERATION" value="SPI_ISR_CAT1"/>
                <d:var name="SpiTimeoutDuration" type="INTEGER" value="32000">
                  <a:a name="IMPORTER_INFO" value="@REC"/>
                </d:var>
                <d:var name="SpiDeviceVariant" type="ENUMERATION" 
                       value="MSPM0G351x">
                  <a:a name="IMPORTER_INFO" value="@REC"/>
                </d:var>
                <d:var name="SpiRegisterReadbackApi" type="BOOLEAN" 
