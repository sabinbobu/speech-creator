                <d:var name="SpiMaxJobsPerSequence" type="INTEGER" value="2"/>
                <d:var name="SpiMaxChannels" type="INTEGER" value="1">
                  <a:a name="IMPORTER_INFO" value="@REC"/>
                </d:var>
                <d:var name="SpiMaxJobs" type="INTEGER" value="2"/>
                <d:var name="SpiMaxSequences" type="INTEGER" value="2"/>
                <d:var name="SpiChannelBuffersAllowed" type="INTEGER" value="1">
                  <a:a name="IMPORTER_INFO" value="@REC"/>
                </d:var>
                <d:var name="SpiDevErrorDetect" type="BOOLEAN" value="false">
