                <d:var name="SpiCancelApi" type="BOOLEAN" value="true">
                  <a:a name="IMPORTER_INFO" value="@REC"/>
                </d:var>
                <d:var name="SpiEnableJobLog" type="BOOLEAN" value="true">
                  <a:a name="IMPORTER_INFO" value="@REC"/>
                </d:var>
                <d:var name="SpiMaxExternalDevices" type="INTEGER" value="2"/>
                <d:var name="SpiMaxJobLogLength" type="INTEGER" value="100">
                  <a:a name="IMPORTER_INFO" value="@REC"/>
                </d:var>
                <d:var name="SpiMaxChannelsPerJob" type="INTEGER" value="1">
                  <a:a name="IMPORTER_INFO" value="@REC"/>
