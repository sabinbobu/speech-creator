FILES_SRC_CDDSPI  := $(FILES_SRC_CDDSPI)                                                                               \
                     $(PATH_SRC_CDD)/CddSpi/$(TYP_FAMILY)/$(TYP_FAMILY)_$(TYP_DERIV)/CddSpi_$(TYP_FAMILY)_$(TYP_DERIV)



include $(PATH_SRC_CDD)/CddSpi/Make/$(TYP_FAMILY)/$(TYP_FAMILY)_$(TYP_DERIV)/_$(TYP_CHIP)/CddChip_040_FlagsAndFiles.gmk