C_INCLUDES_CDDSWI  = $(PATH_SRC_CDD)/CddSwi/Api                                     \
                     $(PATH_SRC_CDD)/CddSwi/Cfg                                     \
                     $(PATH_SRC_CDD)/CddSwi/Gen                                     \
                     $(PATH_SRC_CUST)/Cdd/CddSwi                                    \
                     $(PATH_SRC_CUST)/Cdd/CddSwi/Cfg



# ---------------------------------------------------------------------------------------------------
