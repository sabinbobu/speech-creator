C_INCLUDES_CDDTPSGEN3 =   $(PATH_SRC_CDD)/CddTpsGen3/Api                                        \
                          $(PATH_SRC_CDD)/CddTpsGen3                                            \
                          $(PATH_SRC_CDD)/CddTpsGen3/Cfg                                        \
                          $(PATH_SRC_CDD)/CddTpsGen3/Gen



# ---------------------------------------------------------------------------------------------------
# ---------------------------------------------------------------------------------------------------
#  FILES - The result of this file is to add the specific CDD source files
# ---------------------------------------------------------------------------------------------------
# ---------------------------------------------------------------------------------------------------

FILES_SRC_CDDTPSGEN3  =   $(PATH_SRC_CDD)/CddTpsGen3/Gen/CddTpsGen3                           \
                          $(PATH_SRC_CDD)/CddTpsGen3/Gen/CddTpsGen3_Com


