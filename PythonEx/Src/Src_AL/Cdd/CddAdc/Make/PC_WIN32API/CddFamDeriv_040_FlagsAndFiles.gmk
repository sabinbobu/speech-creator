C_INCLUDES_CDDADC = $(PATH_SRC_CDD)/CddAdc/Api                                                                                                    \
                    $(PATH_SRC_CDD)/CddAdc/$(TYP_FAMILY)/$(TYP_FAMILY)_$(TYP_DERIV)/_$(TYP_CHIP)                                                  \
                    $(PATH_SRC_CDD)/CddAdc

FILES_SRC_CDDADC =  $(PATH_SRC_CDD)/CddAdc/Gen/CddAdc                                                                                            \
                    $(PATH_SRC_CDD)/CddAdc/$(TYP_FAMILY)/$(TYP_FAMILY)_$(TYP_DERIV)/_$(TYP_CHIP)/CddAdc_$(TYP_FAMILY)_$(TYP_DERIV)_$(TYP_CHIP)

C_INCLUDES       := $(C_INCLUDES_CDDADC)                                               \
                    $(C_INCLUDES)

FILES_SRC_CDD    := $(FILES_SRC_CDD)                                                   \
                    $(FILES_SRC_CDDADC)
