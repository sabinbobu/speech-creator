# ---------------------------------------------------------------------------------------------------
# ---------------------------------------------------------------------------------------------------
#  FLAGS - The result of this file is to add the CDD include files
# ---------------------------------------------------------------------------------------------------
# ---------------------------------------------------------------------------------------------------

C_INCLUDES_CDDADC = $(PATH_SRC_CDD)/CddAdc/Api                                           \
                    $(PATH_SRC_CDD)/CddAdc                                               \
                    $(PATH_SRC_CDD)/CddAdc/Gen                                           \
                    $(PATH_SRC_CDD)/CddAdc/Gen/Adc                                       \
                    $(PATH_SRC_CDD)/CddAdc/Gen/Dma                                       \
                    $(PATH_SRC_CDD)/CddAdc/Gen/Lpit                                      \
                    $(PATH_SRC_CDD)/CddAdc/Gen/TrigMux                                   \
                    $(PATH_SRC_CDD)/CddAdc/Gen/Pdb                                       \
                    $(PATH_SRC_CUST)/Cdd/CddAdc/Cfg



# ---------------------------------------------------------------------------------------------------
# ---------------------------------------------------------------------------------------------------
#  FILES - The result of this file is to add the specific CDD source files
# ---------------------------------------------------------------------------------------------------
# ---------------------------------------------------------------------------------------------------

FILES_SRC_CDDADC  = $(PATH_SRC_CDD)/CddAdc/Gen/CddAdc                                 \
                    $(PATH_SRC_CDD)/CddAdc/Gen/Adc/Adc_Drv                            \
                    $(PATH_SRC_CDD)/CddAdc/Gen/Dma/Dma_Job                            \
                    $(PATH_SRC_CDD)/CddAdc/Gen/Lpit/Lpit_Drv                          \
                    $(PATH_SRC_CDD)/CddAdc/Gen/Pdb/Pdb_Drv                            \
                    $(PATH_SRC_CDD)/CddAdc/Gen/TrigMux/TrigMux_Drv


include $(PATH_SRC_CDD)/CddAdc/Make/$(TYP_FAMILY)/$(TYP_FAMILY)_$(TYP_DERIV)/CddDeriv_040_FlagsAndFiles.gmk