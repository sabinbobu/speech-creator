C_INCLUDES_CDDSBC  = $(PATH_SRC_CDD)/CddSbc/Api                \
                     $(PATH_SRC_CDD)/CddSbc/Cfg                \
                     $(PATH_SRC_CDD)/CddSbc/Gen                \
                     $(PATH_SRC_CUST)/Cdd/CddSbc




