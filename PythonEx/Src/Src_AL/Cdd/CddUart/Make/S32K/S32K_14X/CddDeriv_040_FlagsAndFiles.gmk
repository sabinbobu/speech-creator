C_INCLUDES_CDDUART := $(C_INCLUDES_CDDUART)                                                 \
                      $(PATH_SRC_CDD)/CddUart/$(TYP_FAMILY)/$(TYP_FAMILY)_$(TYP_DERIV)


# ---------------------------------------------------------------------------------------------------
# ---------------------------------------------------------------------------------------------------
#  FILES - The result of this file is to add the specific CDD source files
# ---------------------------------------------------------------------------------------------------
# ---------------------------------------------------------------------------------------------------

FILES_SRC_CDDUART   := $(FILES_SRC_CDDUART)                                                                                 \
                       $(PATH_SRC_CDD)/CddUart/$(TYP_FAMILY)/$(TYP_FAMILY)_$(TYP_DERIV)/CddUart_$(TYP_FAMILY)_$(TYP_DERIV)


include $(PATH_SRC_CDD)/CddUart/Make/$(TYP_FAMILY)/$(TYP_FAMILY)_$(TYP_DERIV)/_$(TYP_CHIP)/CddChip_040_FlagsAndFiles.gmk