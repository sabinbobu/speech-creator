# ---------------------------------------------------------------------------------------------------
# ---------------------------------------------------------------------------------------------------
#  FLAGS - The result of this file is to add the CDD include files
# ---------------------------------------------------------------------------------------------------
# ---------------------------------------------------------------------------------------------------

C_INCLUDES_CDDUART = $(PATH_SRC_CDD)/CddUart/Api                                           \
                     $(PATH_SRC_CDD)/CddUart                                               \
                     $(PATH_SRC_CDD)/CddUart/Cfg                                           \
                     $(PATH_SRC_CDD)/CddUart/Gen                                           \
                     $(PATH_SRC_CDD)/CddUart/$(TYP_FAMILY)/$(TYP_FAMILY)_$(TYP_DERIV)



# ---------------------------------------------------------------------------------------------------
# ---------------------------------------------------------------------------------------------------
#  FILES - The result of this file is to add the specific CDD source files
# ---------------------------------------------------------------------------------------------------
# ---------------------------------------------------------------------------------------------------

FILES_SRC_CDDUART  = $(PATH_SRC_CDD)/CddUart/Gen/CddUart                              \
                     $(PATH_SRC_CDD)/CddUart/S32K/S32K_14X/CddUart_S32K_14X 

