C_INCLUDES_CDDVN7140 := $(C_INCLUDES_CDDVN7140)                                                     \
                         $(PATH_SRC_CDD)/CddVn7140/$(TYP_FAMILY)/$(TYP_FAMILY)_$(TYP_DERIV)/_$(TYP_CHIP)


# ---------------------------------------------------------------------------------------------------
