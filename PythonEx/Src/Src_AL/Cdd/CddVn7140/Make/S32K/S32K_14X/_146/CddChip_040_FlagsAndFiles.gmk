                         $(PATH_SRC_CDD)/CddVn7140/$(TYP_FAMILY)/$(TYP_FAMILY)_$(TYP_DERIV)/_$(TYP_CHIP)/CddVn7140_$(TYP_FAMILY)_$(TYP_DERIV)_$(TYP_CHIP)
