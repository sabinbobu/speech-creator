C_INCLUDES_CDDMLC = $(PATH_SRC_CDD)/CddMlc/Api                                           \
                    $(PATH_SRC_CDD)/CddMlc                                               \
                    $(PATH_SRC_CDD)/CddMlc/Adapter                                       \
                    $(PATH_SRC_CDD)/CddMlc/Cfg                                           \
                    $(PATH_SRC_CDD)/CddMlc/Gen

# ---------------------------------------------------------------------------------------------------
# ---------------------------------------------------------------------------------------------------
#  FILES - The result of this file is to add the specific CDD source files
# ---------------------------------------------------------------------------------------------------
# ---------------------------------------------------------------------------------------------------

FILES_SRC_CDDMLC  = $(PATH_SRC_CDD)/CddMlc/Gen/CddMlc                                \
                    $(PATH_SRC_CDD)/CddMlc/Adapter/CddMlc_Adapter


include $(PATH_SRC_CDD)/CddMlc/Make/$(TYP_FAMILY)/$(TYP_FAMILY)_$(TYP_DERIV)/CddDeriv_040_FlagsAndFiles.gmk