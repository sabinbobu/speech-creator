# ---------------------------------------------------------------------------------------------------
# ---------------------------------------------------------------------------------------------------
#  FLAGS - The result of this file is to add the CDD include files
# ---------------------------------------------------------------------------------------------------
# ---------------------------------------------------------------------------------------------------

C_INCLUDES_CDDDMA = $(PATH_SRC_CDD)/CddDma/Api                                                     \
                    $(PATH_SRC_CDD)/CddDma/Gen                                                     \
                    $(PATH_SRC_CUST)/Cdd/CddDma                                                    \
                    $(PATH_SRC_CDD)/CddDma/$(TYP_FAMILY)/$(TYP_FAMILY)_$(TYP_DERIV)                \
                    $(PATH_SRC_CDD)/CddDma/S32K/S32K_14X                                           \
                    $(PATH_SRC_CUST)/Cdd/CddDma/Cfg

# ---------------------------------------------------------------------------------------------------
# ---------------------------------------------------------------------------------------------------
#  FILES - The result of this file is to add the specific CDD source files
# ---------------------------------------------------------------------------------------------------
# ---------------------------------------------------------------------------------------------------

FILES_SRC_CDDDMA  = $(PATH_SRC_CDD)/CddDma/Gen/CddDma                                                                                             \
                    $(PATH_SRC_CDD)/CddDma/$(TYP_FAMILY)/$(TYP_FAMILY)_$(TYP_DERIV)/CddDma_$(TYP_FAMILY)_$(TYP_DERIV)
