# ---------------------------------------------------------------------------------------------------
# ---------------------------------------------------------------------------------------------------

FILES_SRC_CDDDMA := $(FILES_SRC_CDDDMA)                                                     \
                    $(PATH_SRC_CDD)/CddDma/$(TYP_FAMILY)/$(TYP_FAMILY)_$(TYP_DERIV)/CddDma_$(TYP_FAMILY)_$(TYP_DERIV)



include $(PATH_SRC_CDD)/CddDma/Make/$(TYP_FAMILY)/$(TYP_FAMILY)_$(TYP_DERIV)/_$(TYP_CHIP)/CddChip_040_FlagsAndFiles.gmk