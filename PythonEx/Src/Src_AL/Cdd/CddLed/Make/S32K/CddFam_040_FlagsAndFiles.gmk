FILES_SRC_CDDLED  = $(PATH_SRC_CDD)/CddLed/Gen/CddLed                                               \
                    $(PATH_SRC_CDD)/CddLed/Adapter/CddLed_Adapter


include $(PATH_SRC_CDD)/CddLed/Make/$(TYP_FAMILY)/$(TYP_FAMILY)_$(TYP_DERIV)/CddDeriv_040_FlagsAndFiles.gmk