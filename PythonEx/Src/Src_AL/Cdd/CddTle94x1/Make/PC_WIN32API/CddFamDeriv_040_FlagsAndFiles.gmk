C_INCLUDES_CDDTLE94X1 = $(PATH_SRC_CDD)/CddSbc/Api                                           \
						$(PATH_SRC_CDD)/CddSbc/Gen                                           \
						$(PATH_SRC_CDD)/CddTle94x1/Gen                                       \
						$(PATH_SRC_CDD)/CddSbc/Gen/9471                                      \
						$(PATH_SRC_CUST)/Cdd/CddSpi                                          \
						$(PATH_SRC_CDD)/CddSpi/Api                                           \
						$(PATH_SRC_CDD)/CddSpi/Gen                                           \
						$(PATH_SRC_CUST)/Cdd/CddSpi/Cfg                                      \
						$(PATH_SRC_CUST)/Cdd/CddSbc

# ---------------------------------------------------------------------------------------------------
# ---------------------------------------------------------------------------------------------------
#  FILES - The result of this file is to add the specific CDD source files
# ---------------------------------------------------------------------------------------------------
# ---------------------------------------------------------------------------------------------------

FILES_SRC_CDDTLE94X1  = $(PATH_SRC_CDD)/CddTLE94X1/Gen/CddTle94x1                            \
					    $(PATH_SRC_CDD)/CddTLE94X1/Gen/CddTle94x1_Com                        \

